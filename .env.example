# =============================================================================
# Backend Configuration
# =============================================================================
# Comma-separated API keys for the LiteLLM key pool (key_1, key_2, ... in order)
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# LiteLLM model identifier (examples: gemini/gemini-2.0-flash, openai/gpt-4o-mini, groq/llama-3.1-8b-instant)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional: comma-separated per-key models matching LLM_API_KEYS order (defaults to LLM_MODEL for all keys)
# LLM_MODELS=gemini/gemini-2.0-flash,gemini/gemini-2.0-flash

# Optional default system prompt when client omits system_prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# SQLite database URL (Docker Compose mounts a persistent volume at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure request header for testing key failover
ENABLE_FAILURE_SIMULATION=true

# LiteLLM cache toggle and type (local = in-memory cache supported by LiteLLM 1.111+)
CACHE_ENABLED=true
CACHE_TYPE=local

# =============================================================================
# Frontend Configuration (Development default)
# =============================================================================
VITE_API_BASE_URL=http://127.0.0.1:8000
